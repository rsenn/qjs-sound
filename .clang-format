Language: Cpp
BasedOnStyle: LLVM
IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 128

# ------------------------------------------------------------------------------
# Array & Struct Initializer Formatting (Forces 1 item per line)
# ------------------------------------------------------------------------------
# Treat braced initializers with standard C non-compact formatting (one element per line)
Cpp11BracedListStyle: false

# ------------------------------------------------------------------------------
# Prevent breaks after '=' assignment and after open '('
# ------------------------------------------------------------------------------
# High penalty prevents breaking right after the '=' operator
PenaltyBreakAssignment: 10000

# High penalty prevents breaking right after the opening '(' parameter bracket
PenaltyBreakBeforeFirstCallParameter: 10000

# Align parameters on new lines using standard block indents rather than deep bracket column alignment
AlignAfterOpenBracket: BlockIndent

# Allow multiple arguments on the same line up to ColumnLimit
BinPackArguments: true
BinPackParameters: true

# Keep parameters on same line unless forced by ColumnLimit
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false

# Continuation indent when a line must wrap
ContinuationIndentWidth: 4

# ------------------------------------------------------------------------------
# Alignment & Formatting Defaults
# ------------------------------------------------------------------------------
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignEscapedNewlines: DontAlign
AccessModifierOffset: -2
AlignOperands: true
AlignTrailingComments: true

AllowShortBlocksOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false

AlwaysBreakAfterDefinitionReturnType: true
AlwaysBreakBeforeMultilineStrings: false
AlwaysBreakTemplateDeclarations: false

BreakBeforeBinaryOperators: None
BreakBeforeBraces: Attach
BreakBeforeTernaryOperators: true

IndentCaseLabels: true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

PointerAlignment: Left
SortIncludes: false

SpaceAfterCStyleCast: false
SpaceBeforeAssignmentOperators: true
SpaceBeforeParens: ControlStatements
SpaceInEmptyParentheses: false
SpacesInAngles: false
SpacesInContainerLiterals: false
SpacesInCStyleCastParentheses: false
SpacesInParentheses: false
SpacesInSquareBrackets: false

# Line Penalties
PenaltyExcessCharacter: 10
PenaltyBreakComment: 300
PenaltyBreakString: 1000
