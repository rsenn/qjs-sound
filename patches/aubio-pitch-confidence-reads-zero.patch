# aubio-pitch-confidence-reads-zero
#
# the 'yinfft' method reads confidence 0 on a clean 440 Hz sine.
# aubio_pitchyinfft_do() sets p->peak_pos only in the short-period
# branch; when tau > short_period it stays 0, and
# get_confidence() returns 1 - yinfft->data[0] == 1 - 1 == 0.
#
# repro:
#
#   import { AubioPitch } from 'aubio';
#   const p = new AubioPitch('yinfft', 4096, 2048, 44100);
#   p.setUnit('Hz');
#   const h = new Float32Array(2048);
#   for (let i = 0; i < 2048; i++)
#     h[i] = 0.8 * Math.sin(2 * Math.PI * 440 * i / 44100);
#   p.process(h);
#   p.confidence; // 0, expected close to 1
#
# fix: record tau as peak_pos in the long-period branch.

diff --git a/src/pitch/pitchyinfft.c b/src/pitch/pitchyinfft.c
index b613f60..ac6c184 100644
--- a/src/pitch/pitchyinfft.c
+++ b/src/pitch/pitchyinfft.c
@@ -160,6 +160,7 @@ aubio_pitchyinfft_do (aubio_pitchyinfft_t * p, const fvec_t * input, fvec_t * ou
     //return fvec_quadratic_peak_pos (yin,tau,1);
     /* additional check for (unlikely) octave doubling in higher frequencies */
     if (tau > p->short_period) {
+      p->peak_pos = tau;
       output->data[0] = fvec_quadratic_peak_pos (yin, tau);
     } else {
       /* should compare the minimum value of each interpolated peaks */
